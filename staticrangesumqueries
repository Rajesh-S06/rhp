#include<iostream>
#include<vector>
#include<algorithm>
#define ll long long int
using namespace std;

void solve(){
    ll n, q;
    cin >> n >> q;

    vector<ll> arr(n + 1);
    vector<ll> prefix(n + 1, 0);

    for (ll i = 1; i <= n; i++) {
        cin >> arr[i];
        prefix[i] = prefix[i - 1] + arr[i];
    }

    while (q--) {
        ll a, b;
        cin >> a >> b;
        cout << prefix[b] - prefix[a - 1] << "\n";
    }
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    solve();

    return 0;
}
